  "authors": [
    "esquivel-stuff"
  ],
  "contact": {
    "sources": "https://github.com/esquivel-stuff/starfall-fabric-mod"
  },
  "license": "MIT",
  "icon": "assets/starfall/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.esquivel.starfall.Starfall"
    ],
    "client": [
      "dev.esquivel.starfall.client.StarfallClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
